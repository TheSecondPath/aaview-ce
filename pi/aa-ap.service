[Unit]
Description=velosterAA: Wi-Fi access point for the phone (wireless Android Auto)
After=NetworkManager.service
Wants=NetworkManager.service
Before=veloaa-aa.service

[Service]
ExecStart=/usr/local/sbin/aa-ap watch
ExecStopPost=/usr/local/sbin/aa-ap down
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
