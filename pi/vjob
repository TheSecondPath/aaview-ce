#!/bin/sh
# vjob: run vagent commands on the head unit from the Pi, like a (slow) command line.
#   vjob 'dir \Storage Card\ISV' 'mem' 'reg HKLM\Drivers\USB'
#   echo 'type \MD\aaview\aaview_log.txt' | vjob -
# It writes the commands as a job on the stick image, unplugs the stick, waits for CE to let go of it, plugs it
# back in, waits for vagent to finish the job, and prints the results. Expect about 10 s per round trip. The wait
# after unplugging is SETTLE, 5 s by default. CE notices an unplug within 1-3 s, and a 3 s wait proved too short:
# CE wrote a stale FAT back.
#
# Only one stick job runs at a time: vjob, load_stick.sh and the web page's jobs all take a lock (flock) on the
# image. Whatever happens (an error, Ctrl-C), the image is unmounted and the stick plugged back in on the way out.
set -e
IMG=${STICK_IMG:-/srv/stick.img}
MNT=/mnt/stick
SETTLE=${SETTLE:-5}
WAIT=${WAIT:-300}
LOCK_WAIT=${LOCK_WAIT:-600}

[ $# -gt 0 ] || { echo "usage: vjob 'command' ['command' ...]  |  vjob -  (commands on stdin)"; exit 1; }
[ -f "$IMG" ] || { echo "vjob: no stick image at $IMG" >&2; exit 1; }

tmp=$(mktemp)
ejected=0
mounted=0
cleanup() {
    if [ $mounted = 1 ]; then sudo umount "$MNT" 2>/dev/null || true; fi
    if [ $ejected = 1 ]; then sudo stick-gadget insert || echo "vjob: could not plug the stick back in" >&2; fi
    rm -f "$tmp"
}
trap cleanup EXIT
trap 'exit 130' INT TERM HUP

exec 9<"$IMG"
if ! flock -w "$LOCK_WAIT" 9; then
    echo "vjob: the stick has been busy for $LOCK_WAIT s (another vjob or load_stick.sh)" >&2
    exit 3
fi

if [ "$1" = "-" ]; then cat > "$tmp"; else for c in "$@"; do printf '%s\n' "$c" >> "$tmp"; done; fi
name="$(date +%m%d_%H%M%S)_vjob"

sudo mkdir -p "$MNT"
ejected=1
sudo stick-gadget eject
sleep "$SETTLE"
sudo mount -o loop,uid="$(id -u)",gid="$(id -g)" "$IMG" "$MNT"
mounted=1
sed 's/\r\?$/\r/' "$tmp" > "$MNT/vagent/jobs/$name.job"
sync
sudo umount "$MNT"
mounted=0
sudo stick-gadget insert
ejected=0
echo "queued $name; waiting for vagent..." >&2

t0=$(date +%s)
while :; do
    sleep 1
    if sudo mount -o loop,ro "$IMG" "$MNT" 2>/dev/null; then
        mounted=1
        if grep -q '^DONE after' "$MNT/vagent/results/$name.txt" 2>/dev/null; then
            tr -d '\r' < "$MNT/vagent/results/$name.txt"
            exit 0
        fi
        sudo umount "$MNT"
        mounted=0
    fi
    if [ $(( $(date +%s) - t0 )) -gt "$WAIT" ]; then
        echo "no result after $WAIT s (is vagent running? is the stick mounted as \\MD?)" >&2
        exit 2
    fi
done
