[Unit]
Description=velosterAA: Android Auto Bluetooth start-up (aarecvd --bt-only); the session is aarecvd.service
# Not network-online.target: away from home there is no network to wait for, and on the dev build, where
# veloaa-web pulls that target in, it held Android Auto up for as long as NetworkManager waited.
After=bluetooth.service stick-gadget.service aa-ap.service
Wants=bluetooth.service

[Service]
ExecStart=/usr/local/lib/veloaa/aarecvd --bt-only
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
