[Unit]
Description=velosterAA: web page for the head unit (camera view, vagent jobs). Dev build only
After=network-online.target stick-gadget.service
Wants=network-online.target

[Service]
User=root
ExecStart=/usr/bin/python3 /usr/local/bin/rmwork_web.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
